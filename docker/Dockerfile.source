# syntax=docker.io/docker/dockerfile:1.7-labs
FROM --platform=${TARGETPLATFORM} ubuntu:24.04 AS base

ENV PATH="${PATH}:/root/.cargo/bin/"
ARG TARGETOS
ARG TARGETARCH

RUN apt-get update && apt-get install -y \
    build-essential \
    curl \
    git \
    cmake \
    libgmp-dev \
    libmpfr-dev \
    libmpfr6 \
    wget \
    m4 \
    pkg-config \
    gcc \
    g++ \
    make \
    autoconf \
    automake \
    libtool \
    libssl-dev \
    libflint-dev \
    protobuf-compiler \
    clang \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

FROM base AS gmp-builder

ARG GMP_VERSION=6.3.0
ARG GMP_SHA256=a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898
RUN archive="gmp-${GMP_VERSION}.tar.xz" && \
    for base_url in \
        https://mirrors.kernel.org/gnu/gmp \
        https://mirrors.ocf.berkeley.edu/gnu/gmp \
        https://www.mirrorservice.org/sites/ftp.gnu.org/gnu/gmp \
        https://ftp.gnu.org/gnu/gmp; do \
      if wget --timeout=20 --tries=2 -O "${archive}" "${base_url}/${archive}"; then \
        break; \
      fi; \
      rm -f "${archive}"; \
    done && \
    test -s "${archive}" && \
    echo "${GMP_SHA256}  ${archive}" | sha256sum -c - && \
    tar -xf "${archive}" && \
    cd gmp-${GMP_VERSION} && \
    ./configure \
        --prefix=/usr/local \
        --enable-static \
        --disable-shared \
        --with-pic \
        CFLAGS="-O3" && \
    make -j$(nproc) && \
    make install

FROM gmp-builder AS flint-builder

RUN git clone --branch flint-3.0 --depth 1 https://github.com/flintlib/flint.git && \
    cd flint && \
    ./bootstrap.sh && \
    ./configure \
        --prefix=/usr/local \
        --with-gmp=/usr/local \
        --with-mpfr=/usr/local \
        --enable-static \
        --disable-shared \
        CFLAGS="-O3 -fPIC" && \
    make -j$(nproc) && \
    make install

FROM base AS emp-builder

WORKDIR /opt/quilscan-qclient
COPY install-emp.sh .
COPY emp-tool emp-tool
COPY emp-ot emp-ot

RUN bash install-emp.sh && \
    cd emp-tool && \
    sed -i 's/add_library(${NAME} SHARED ${sources})/add_library(${NAME} STATIC ${sources})/g' CMakeLists.txt && \
    rm -rf build && \
    mkdir build && \
    cd build && \
    cmake .. -DCMAKE_INSTALL_PREFIX=/usr/local && \
    cd .. && \
    make -j$(nproc) && \
    make install && \
    cd /opt/quilscan-qclient/emp-ot && \
    rm -rf build && \
    mkdir build && \
    cd build && \
    cmake .. -DCMAKE_INSTALL_PREFIX=/usr/local && \
    cd .. && \
    make -j$(nproc) && \
    make install

FROM base AS rust-base

COPY docker/rustup-init.sh /opt/rustup-init.sh
RUN /opt/rustup-init.sh -y --profile minimal

FROM base AS qclient-context

COPY --from=flint-builder /usr/local /usr/local
COPY --from=emp-builder /usr/local /usr/local
COPY --from=rust-base /root/.cargo /root/.cargo
COPY --from=rust-base /root/.rustup /root/.rustup

ENV PATH="${PATH}:/root/.cargo/bin/"
WORKDIR /opt/quilscan-qclient

COPY Cargo.toml Cargo.lock ./
COPY crates crates
COPY node/execution/intrinsics/global/compat node/execution/intrinsics/global/compat
COPY protobufs protobufs

FROM qclient-context AS build-qclient

RUN --mount=type=cache,id=cargo-registry,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/root/.cargo/git,sharing=locked \
    --mount=type=cache,id=cargo-target-qclient,target=/opt/quilscan-qclient/target \
    cargo build --release -p quil-client --bin qclient && \
    cp target/release/qclient /usr/bin/qclient

FROM scratch AS qclient-unix
COPY --from=build-qclient /usr/bin/qclient /qclient
ENTRYPOINT ["/qclient"]

FROM qclient-unix AS qclient-linux
FROM qclient-unix AS qclient-darwin
FROM qclient-${TARGETOS} AS qclient
